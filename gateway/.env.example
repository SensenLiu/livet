# LiveT Gateway — Environment template
# Copy to .env and fill in. .env is gitignored.

# ===== Service =====
LIVET_ENV=dev               # dev / staging / prod
LIVET_PORT=8000
LIVET_LOG_LEVEL=info

# ===== Sentry (optional, default off; users can opt-out per device) =====
SENTRY_DSN=

# ===== Rate limit / Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== LLM upstream =====
DEEPSEEK_API_KEY=sk-e4c0248f70414a8cbb71fbb2084b7610
DEEPSEEK_BASE_URL=https://api.deepseek.com

DOUBAO_API_KEY=7b740eb6-812b-4643-9376-1420034fec9a
DOUBAO_ENDPOINT_ID=ep-m-20260503212145-pqkz8          # 豆包 Pro-32k endpoint id (火山方舟控制台)
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== ASR + TTS (single vendor: 豆包 / 火山引擎) =====
# Console: https://console.volcengine.com/speech/
# Both ASR and TTS authenticate via AK/SK signing (NOT the LLM doubao_api_key).
VOLC_AK_ID=
VOLC_SK=

# ASR (实时语音识别 SAMI streaming)
VOLC_ASR_APP_ID=
VOLC_ASR_CLUSTER=volcengine_streaming_common

# TTS (语音合成大模型, CosyVoice-style)
VOLC_TTS_APP_ID=
VOLC_TTS_VOICE=zh_female_qingxin_v2_mars_bigtts

# ===== Subscription verification =====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=

# Apple IAP (V1 不上 iOS, 占位)
APPLE_IAP_SHARED_SECRET=

# ===== Auth =====
DEVICE_TOKEN_SECRET=         # 用于签 device-bound short-lived token
